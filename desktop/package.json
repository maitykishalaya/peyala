{
  "name": "peyala-pos-desktop",
  "version": "1.0.0",
  "description": "Peyala Restaurant Operations & POS Desktop Terminal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Peyala",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.peyala.pos",
    "productName": "Peyala POS",
    "directories": {
      "output": "../dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "./icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "shortcutName": "Peyala POS",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
